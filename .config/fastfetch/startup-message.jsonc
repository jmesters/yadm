{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "color": {
            "1": "blue"
        }
    },
    "modules": [
        "break",
        "title",
        "break",
        "separator",
        "break",
        "datetime",
        "uptime",
        "users",
        "break",
        "os",
        {
            "type": "localip"
        },
        "shell",
        "break",
        {
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        "memory",
        "physicalmemory",
        {
            "type": "swap",
            "separate": true
        },
        "disk",
        "break"
    ]
}

